{
    "name": "markdown-to-image",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm icons:generate && rsbuild build",
        "dev": "rsbuild dev --open",
        "preview": "rsbuild preview",
        "icons:generate": "node scripts/generate-icons.mjs",
        "icons:check": "node scripts/generate-icons.mjs --check",
        "format": "prettier --write .",
        "fg": "npm run format && git add . && git commit -m \"feat: format\"",
        "prepare": "husky",
        "lint": "eslint .",
        "routes:generate": "node scripts/generate-routes.mjs",
        "typecheck": "pnpm routes:generate && tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/noto-sans-sc": "^5.3.0",
        "@tanstack/react-query": "^5.103.1",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.3.0",
        "core-js": "^3.50.0",
        "deepsea-tools": "^5.48.5",
        "lucide-react": "^1.24.0",
        "modern-screenshot": "^4.7.0",
        "next-themes": "^0.4.6",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hot-toast": "^2.6.1",
        "react-markdown": "^10.1.0",
        "react-router": "^8.4.0",
        "rehype-highlight": "^7.0.2",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-breaks": "^4.0.0",
        "remark-cjk-friendly": "^2.3.1",
        "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
        "remark-gfm": "^4.0.1",
        "shadcn": "^4.13.0",
        "soda-tanstack-query": "^0.0.16",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@1adybug/eslint": "^0.0.17",
        "@1adybug/prettier": "^0.0.33",
        "@resvg/resvg-js": "^2.6.2",
        "@rsbuild/core": "^2.2.8",
        "@rsbuild/plugin-babel": "^2.1.0",
        "@rsbuild/plugin-react": "^2.0.1",
        "@rsbuild/plugin-svgr": "^2.0.5",
        "@rsbuild/plugin-tailwindcss": "^2.0.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "husky": "^9.1.7",
        "jsdom": "^30.1.1",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.8",
        "sdrr": "^0.2.10",
        "tailwindcss": "^4.3.2",
        "typescript": "^6.0.3",
        "vitest": "^5.0.1"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    }
}
