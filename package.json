{
    "name": "markdown-to-image",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm icons:generate && next build && node scripts/generate-service-worker.mjs",
        "dev": "next dev",
        "start": "next start",
        "preview": "next start",
        "icons:generate": "node scripts/generate-icons.mjs",
        "icons:check": "node scripts/generate-icons.mjs --check",
        "format": "prettier --write .",
        "fg": "npm run format && git add . && git commit -m \"feat: format\"",
        "prepare": "husky",
        "lint": "eslint .",
        "typecheck": "next typegen && tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/noto-sans-sc": "^5.3.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.3.0",
        "ipaddr.js": "^2.2.0",
        "lucide-react": "^1.24.0",
        "modern-screenshot": "^4.7.0",
        "next": "16.4.2",
        "next-themes": "^0.4.6",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hot-toast": "^2.6.1",
        "react-markdown": "^10.1.0",
        "rehype-highlight": "^7.0.2",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-breaks": "^4.0.0",
        "remark-cjk-friendly": "^2.3.1",
        "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
        "remark-gfm": "^4.0.1",
        "shadcn": "^4.13.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@1adybug/eslint": "^0.0.17",
        "@1adybug/prettier": "^0.0.33",
        "@resvg/resvg-js": "^2.6.2",
        "@tailwindcss/postcss": "^4.3.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.5",
        "husky": "^9.1.7",
        "jsdom": "^30.1.1",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.8",
        "tailwindcss": "^4.3.2",
        "typescript": "^6.0.3",
        "vitest": "^5.0.1"
    },
    "engines": {
        "node": "24.x"
    },
    "packageManager": "pnpm@11.10.0",
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    }
}
